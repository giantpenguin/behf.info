  <Info>
    <Parent>Settings_Program</Parent>
  </Info>
  <Translations>
    <Translation Language="en">You have enrolled program: [+programTitle].
Check your email for upcoming information regrading the program.
Thank for enrolling!</Translation>
    <Translation Language="vi">Bạn đã đăng ký chương trình: [+programTitle].
Kiểm tra email của bạn để có thông tin liên quan.
Cảm ơn bạn đã tham gia!</Translation>
  </Translations>
</Dictionary>