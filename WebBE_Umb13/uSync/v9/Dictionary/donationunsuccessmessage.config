  <Info>
    <Parent>Settings_Donation</Parent>
  </Info>
  <Translations>
    <Translation Language="en">Oops! An error occurred while processing your donation transaction.
Please contact our Care Team for help.</Translation>
    <Translation Language="vi">Rất tiếc! Đã xảy ra lỗi khi xử lý giao dịch quyên góp của bạn.
Vui lòng liên hệ với Đội ngũ Chăm sóc của chúng tôi để được hỗ trợ.</Translation>
  </Translations>
</Dictionary>