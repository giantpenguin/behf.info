                "rowSpan": 1
              },
              {
                "contentUdi": "umb://element/e548ef7372f2450e9e99e21ef04169fd",
                "areas": [],
                "columnSpan": 6,
                "rowSpan": 1
              },
              {
                "contentUdi": "umb://element/62ca624209174c309e9f4e531ae7fdb2",
                "areas": [],
                "columnSpan": 6,
                "rowSpan": 1
              },
              {
                "contentUdi": "umb://element/8b2d6dcc6fce4b47baa65fe9dfa1ebe0",
                "areas": [],
                "columnSpan": 6,
                "rowSpan": 1
              }
            ]
          }
        ],
        "columnSpan": 12,
        "rowSpan": 1
      }
    ]
  },
  "contentData": [
    {
      "contentTypeKey": "fe26a33e-9f64-4725-954d-dc75d53f5114",
      "udi": "umb://element/0033891fc9d242698c1354bd57997292"
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "1",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "",
      "highlightParagraph": "Our programs are designed to meet the unique needs of diverse group, fostering growth, balance, and well-being. They cater to youth, students, university staff, organizations, NGOs, families, homemakers, senior citizens, volunteers, and professionals across various sectors.",
      "iconImage": [],
      "iconImageBigger": "0",
      "iconImageCaption": "",
      "iconImageOnRight": "0",
      "paragraph": {
        "markup": "<h3>Here’s how BEHF can make a meaningful impact on your life:</h3>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/f50d735ad85149ac91b612648968e9dc"
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "1",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "",
      "highlightParagraph": "",
      "iconImage": [
        {
          "key": "c62996ff-a89e-443d-b35c-aa0cf0186da2",
          "mediaKey": "3043d621-e210-4851-a5d3-395ee36f3fc1"
        }
      ],
      "iconImageBigger": "1",
      "iconImageCaption": "",
      "iconImageOnRight": "1",
      "paragraph": {
        "markup": "<h4>Trusted Expertise</h4>\n<p>Led by Master Pradeep Vijay, a renowned meditation and mindfulness expert with over <strong>16 years of international teaching</strong> experience.</p>\n<h4>Tailored Solutions</h4>\n<p>From <strong>beginner to experienced</strong>, the programs are customized to meet the specific needs of the intended audience.</p>\n<h4>Practical Effectives</h4>\n<p>Meditation techniques emphasize <strong>natural breathing and mental stillness, requiring neither complex tools nor lengthy training</strong>. This ensures immediate impact and easy application on day-to-day life.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/e548ef7372f2450e9e99e21ef04169fd"
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "1",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "",
      "highlightParagraph": "",
      "iconImage": [
        {
          "key": "5e31682e-6de5-4583-a317-d2f54283e8ea",
          "mediaKey": "3a9fe812-42df-4197-81b1-b7ceeaa63f94"
        }
      ],
      "iconImageBigger": "1",
      "iconImageCaption": "",
      "iconImageOnRight": "0",
      "paragraph": {
        "markup": "<h4>Sustainable Impact</h4>\n<p>Dedicated to fostering growth, balance, and well-being, while creating a <strong>cohesive and sustainable culture</strong> for diverse groups.</p>\n<h4>Community Support</h4>\n<p>By choosing BEHF, you become part of a vibrant, supportive community that shares one’s vision of living a balanced and harmonious life, <strong>empowering one another to grow together</strong>.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/62ca624209174c309e9f4e531ae7fdb2"
    },
    {
      "backgroundColor": {
        "value": "0dcaf0",
        "label": "--bs-cyan-rgb",
        "sortOrder": 2,
        "id": "9"
      },
      "backgroundColorOpacity": "0.125",
      "contentTypeKey": "ffb9846c-7933-4578-8bf2-867a66fc6bad",
      "image": [],
      "paragraph": {
        "markup": "<p>Through our teachings, we aim to empower all to cultivate balance, resilience, and mindful living, contributing to a more harmonious and loving world.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/8b2d6dcc6fce4b47baa65fe9dfa1ebe0"
    }
  ],
  "settingsData": [
    {
      "contentTypeKey": "e40dc2c5-e4e4-4641-a53d-e1ffbd5ffb16",
      "figures": {
