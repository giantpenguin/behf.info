      <Value Culture="vi"><![CDATA[{
  "layout": {
    "Umbraco.BlockGrid": [
      {
        "contentUdi": "umb://element/8d628b72ede74689a0b4ba11b7b047ca",
        "settingsUdi": "umb://element/659575d470a741988de3921546a76daf",
        "areas": [
          {
            "key": "c4b3726a-9414-45f6-a061-4d5509bc7a72",
            "items": [
              {
                "contentUdi": "umb://element/db8673f45d86461e9320a7080616423e",
                "areas": [],
                "columnSpan": 6,
                "rowSpan": 1
              },
              {
                "contentUdi": "umb://element/9a59d3cf0f3a4bb19984aac8b6218f86",
                "areas": [],
