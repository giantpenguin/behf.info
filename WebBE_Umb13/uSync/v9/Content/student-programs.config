      <Value Culture="vi"><![CDATA[{
  "layout": {
    "Umbraco.BlockGrid": [
      {
        "contentUdi": "umb://element/06ccff25344041d2bbcc46242472fd47",
        "settingsUdi": "umb://element/9a027dcbbedb4f728a04f8e259bb1ae1",
        "areas": [
          {
            "key": "c4b3726a-9414-45f6-a061-4d5509bc7a72",
            "items": [
              {
                "contentUdi": "umb://element/d6c3319552184aa6bf9f53b1fbeb52c8",
