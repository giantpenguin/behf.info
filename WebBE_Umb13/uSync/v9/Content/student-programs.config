          }
        ],
        "columnSpan": 12,
        "rowSpan": 1
      }
    ]
  },
  "contentData": [
    {
      "contentTypeKey": "fe26a33e-9f64-4725-954d-dc75d53f5114",
      "udi": "umb://element/06ccff25344041d2bbcc46242472fd47"
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "",
      "highlightParagraph": "Master Pradeep Vijay là một chuyên gia đào tạo Khoa học thiền định và Chánh niệm, với sứ mệnh mang lại bình an và hạnh phúc cho mọi người.",
      "paragraph": {
        "markup": "<p>Master Pradeep Vijay (sinh năm 1982 tại Ấn Độ), là một chuyên gia đào tạo Khoa học Thiền định và Chánh niệm. Hiện nay, thầy Pradeep đang là người điều hành Thiền viện Agathiyar Pyramid Dhyana Ashram, một trung tâm thiền quốc tế tại Tamil Nadu, Ấn Độ.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/d6c3319552184aa6bf9f53b1fbeb52c8"
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "Hành Trình Học Vấn và Thiền Định",
      "highlightParagraph": "",
      "paragraph": {
        "markup": "<ul>\n<li><strong>Học vấn:</strong> Cử nhân Kỹ thuật (Công nghệ Thông tin) tại Chennai, Ấn Độ và Thạc sĩ Hệ thống Thông tin tại Melbourne, Úc.</li>\n<li><strong>Hành trình thiền:</strong> Master Pradeep Vijay bắt đầu hành trình thiền định của mình từ khi còn trẻ, được truyền cảm hứng bởi sức mạnh của sự tĩnh lặng và chánh niệm. Ông đã dành hơn 16 năm nghiên cứu và thực hành các phương pháp thiền truyền thống, đặc biệt là Thiền Quan sát hơi thở, kết hợp với cách tiếp cận hiện đại để giải quyết những thách thức trong cuộc sống và công việc.</li>\n</ul>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/996e0f6eb7024961940a503a444cfcfd"
    },
    {
      "actionLink": "",
      "contentTypeKey": "6bfd106c-7558-496b-829c-992ecaaf9c73",
      "heading": "Sứ mệnh lan tỏa giá trị của Thiền định",
      "highlightParagraph": "Với sứ mệnh lan tỏa giá trị của thiền định, ông đã tổ chức nhiều khóa đào tạo, hội thảo và chương trình thực hành, giúp người tham gia khám phá tiềm năng của bản thân và đạt được sự cân bằng trong cuộc sống.",
      "image": [
        {
          "key": "6bd84f7c-da53-4303-ac0f-062a91d20fb1",
          "mediaKey": "020f6fee-ce91-4692-8ec7-83fd1df222a9"
        }
      ],
      "mediaOnRight": "0",
      "notUseJbtOuter": "0",
      "paragraph": {
        "markup": "<p>Trên hành trình của mình, Master Pradeep đã truyền cảm hứng và hướng dẫn cho hàng nghìn cá nhân, từ các nhà lãnh đạo doanh nghiệp, giáo viên, bác sĩ đến nhân viên văn phòng và sinh viên trên toàn thế giới.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "shadowRichtext": "0",
      "showIcon": "0",
      "subHeading": "",
      "udi": "umb://element/9252da62930547a2b3bf372f1e95ef51",
      "youtubeVideo": ""
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "Triết lý và Ảnh hưởng đối với BEHF",
      "highlightParagraph": "Master Pradeep luôn tin rằng sự thay đổi không bắt đầu từ những điều lớn lao, mà từ việc mỗi người biết cách quản lý bản thân, tạo ra giá trị và lan tỏa năng lượng tích cực. Tầm nhìn và triết lý của ông chính là kim chỉ nam cho mọi hoạt động của BEHF, đưa tổ chức trở thành một trong những doanh nghiệp xã hội tiên phong trong lĩnh vực thiền và chánh niệm.",
      "paragraph": {
        "markup": "<p>Triết lý của Master Pradeep được xây dựng dựa trên niềm tin rằng thiền và chánh niệm không chỉ là những công cụ rèn luyện cá nhân mà còn là nền tảng để xây dựng đội ngũ mạnh mẽ, lãnh đạo xuất sắc, và tổ chức hiệu quả. Ông luôn nhấn mạnh rằng:</p>\n<ul>\n<li><strong>Thiền định là kỹ năng:</strong> Giúp tăng cường sự tập trung, nâng cao khả năng ra quyết định và cải thiện hiệu suất làm việc.</li>\n<li><strong>Chánh niệm là năng lực:</strong> Mang lại sự hiện diện trọn vẹn và sự sáng suốt trong mọi tình huống.</li>\n</ul>\n<p>Dưới sự dẫn dắt của Master Pradeep, BEHF đã phát triển các chương trình độc đáo, kết hợp giữa triết lý thiền định truyền thống và ứng dụng thực tiễn trong công việc và cuộc sống. Ông đóng vai trò là người truyền cảm hứng và cố vấn chiến lược cho BEHF, giúp tổ chức lan tỏa giá trị thiền và chánh niệm đến cộng đồng doanh nghiệp, tổ chức, và cá nhân trên toàn cầu.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/fd987f11e5f6490e8bd287d219fa345c"
    },
    {
      "backgroundColor": {
        "value": "0dcaf0",
        "label": "--bs-cyan-rgb",
        "sortOrder": 2,
        "id": "9"
      },
      "backgroundColorOpacity": "0.875",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "Triết lý giảng dạy của Thầy Pradeep Vijay",
      "highlightParagraph": "",
      "paragraph": {
        "markup": "<ul>\n<li><strong>Phương pháp đơn giản, hiệu quả tức thì:</strong> Các kỹ thuật thiền tập trung vào hơi thở tự nhiên và sự tĩnh lặng tâm trí, không yêu cầu công cụ phức tạp hay thời gian dài để thành thạo.</li>\n<li><strong>Phong cách truyền tải độc đáo:</strong> Với sự hài hước, nhân văn và các ví dụ thực tế, thầy biến những khái niệm trừu tượng trở thành dễ hiểu và gần gũi.</li>\n<li><strong>Ứng dụng thực tiễn trong doanh nghiệp:</strong> Thầy đã giúp nhiều tổ chức cải thiện năng suất lao động, giảm tỷ lệ nghỉ việc và nâng cao sự hài lòng của nhân viên qua các khóa đào tạo chuyên biệt.</li>\n</ul>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/4383608f8af5443e860a388a541820ab"
    },
    {
      "backgroundColor": {
        "value": "20c997",
        "label": "--bs-teal-rgb",
        "sortOrder": 10,
        "id": "8"
      },
      "backgroundColorOpacity": "1",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "Lợi ích cho Doanh nghiệp và Lãnh đạo",
      "highlightParagraph": "Master Pradeep Vijay không chỉ mang đến một chương trình đào tạo mà còn là một hành trình thay đổi tư duy và phát triển bền vững cho doanh nghiệp của bạn.",
      "paragraph": {
        "markup": "<ul>\n<li><strong>Nâng cao năng lực lãnh đạo:</strong> Giúp các nhà quản lý duy trì sự tỉnh táo, sáng suốt trong điều hành.</li>\n<li><strong>Xây dựng văn hóa tổ chức bền vững:</strong> Tăng cường tinh thần hợp tác, sáng tạo và hiệu quả trong công việc.</li>\n<li><strong>Giảm áp lực và cải thiện tinh thần:</strong> Hỗ trợ lãnh đạo và đội ngũ vượt qua thách thức một cách tích cực và hiệu quả.</li>\n</ul>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/4777fd6a774e44708feaf5e6eca57fb7"
    }
  ],
  "settingsData": [
    {
      "contentTypeKey": "e40dc2c5-e4e4-4641-a53d-e1ffbd5ffb16",
      "figures": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/c48293d6586e49e5bbe27102fb98638b"
            }
          ]
        },
