  "contentData": [
    {
      "contentTypeKey": "fe26a33e-9f64-4725-954d-dc75d53f5114",
      "udi": "umb://element/639e7c3dcbfc4219a4fc6c4abb8a0ba8"
    },
    {
      "actionLink": [
        {
          "name": "Tìm Hiểu Thêm",
          "udi": "umb://document/12e65d39f0304a72b78315c54ab807fe"
        }
      ],
      "contentTypeKey": "6bfd106c-7558-496b-829c-992ecaaf9c73",
      "heading": "Doanh Nghiệp Xã Hội Tiên Phong",
      "highlightParagraph": "Chúng tôi mang đến những giải pháp thực tiễn, giúp tổ chức xây dựng đội ngũ gắn kết, lãnh đạo sáng suốt, và tạo ra môi trường làm việc tích cực, hiệu quả.",
      "image": [
        {
          "key": "315ad391-2584-4cd8-bfc1-4076bdcf646c",
          "mediaKey": "51583059-cff9-4495-909d-a065d3782823"
        }
      ],
      "mediaOnRight": "0",
      "notUseJbtOuter": "0",
      "paragraph": {
        "markup": "<p>BEHF là doanh nghiệp xã hội chuyên cung cấp giải pháp ứng dụng thiền và chánh niệm như một kỹ năng và năng lực mới để nâng cao hiệu suất làm việc và phát triển bền vững trong doanh nghiệp.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "shadowRichtext": "1",
      "showIcon": "0",
      "subHeading": "Breath Energy Health Foundation",
      "udi": "umb://element/0df1eb1f20a2414c8c0e7a807ccae67a",
      "youtubeVideo": ""
    },
    {
      "contentTypeKey": "83e6f05b-2396-4781-9956-24e2a4f3e804",
      "displayStyle": [
        "circle"
      ],
      "heading": "Phương Châm Hoạt Động",
      "iconPosition": "",
      "image": [
        {
          "key": "108fdf98-af47-4c79-9ba8-d65ce2782e07",
          "mediaKey": "593b14d6-6879-4b7c-960e-076826a21fcf"
        }
      ],
      "items": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/57c53ad61df84152996c2bec66e2e58f"
            },
            {
              "contentUdi": "umb://element/49d7fbeaf87d47ed88cdf237e46e3e6f"
            },
            {
              "contentUdi": "umb://element/22ae6ef6fa554c17b91e13e44d5984c8"
            },
            {
              "contentUdi": "umb://element/08ee912cd2f64f8d9074ef2ee099667f"
            }
          ]
        },
        "contentData": [
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Lòng nhân ái",
            "iconImage": [
              "love-around.svg"
            ],
            "paragraph": "Chúng tôi được thúc đẩy bởi mong muốn thực sự nuôi dưỡng lòng tốt và lòng trắc ẩn.",
            "udi": "umb://element/57c53ad61df84152996c2bec66e2e58f"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Sự chuyển hoá",
            "iconImage": [
              "reforestation.svg"
            ],
            "paragraph": "Chúng tôi tin vào sức mạnh của thực hành chánh niệm để thúc đẩy sự phát triển cá nhân, nâng cao nhận thức về bản thân và mở khóa tiềm năng bên trong của bạn.",
            "udi": "umb://element/49d7fbeaf87d47ed88cdf237e46e3e6f"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Tính khiêm nhường",
            "iconImage": [
              "eye-palm.svg"
            ],
            "paragraph": "Chúng tôi cung cấp hướng dẫn mà không phán xét, thúc đẩy môi trường chấp nhận và tự trắc ẩn.",
            "udi": "umb://element/22ae6ef6fa554c17b91e13e44d5984c8"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Tình bạn chân thành",
            "iconImage": [
              "affection.svg"
            ],
            "paragraph": "Chúng tôi tin vào việc thúc đẩy một không gian hỗ trợ và chào đón, nơi mọi người có thể kết nối, học hỏi lẫn nhau và cảm thấy có ý thức về sự gắn bó.",
            "udi": "umb://element/08ee912cd2f64f8d9074ef2ee099667f"
          }
        ],
        "settingsData": []
      },
      "paragraph": "",
      "subHeading": "Tại Sao Chọn Chúng Tôi",
      "udi": "umb://element/13a52341b8234cdd95243cb799963723"
    },
    {
      "contentTypeKey": "fe26a33e-9f64-4725-954d-dc75d53f5114",
      "udi": "umb://element/bb5349e234d84c4e8ca3e50abab350f9"
    },
    {
      "backgroundColor": "",
      "backgroundColorOpacity": "1",
      "contentTypeKey": "4ac6dfe6-3e77-4ebb-b1d7-f73ee48847f4",
      "heading": "Cam Kết Trách Nhiệm Xã Hội",
      "highlightParagraph": "Là một doanh nghiệp xã hội, BEHF cam kết tái đầu tư ít nhất 51% lợi nhuận của mình vào các hoạt động nhằm thúc đẩy giá trị xã hội.",
      "paragraph": {
        "markup": "<p>Chúng tôi tập trung giải quyết các thách thức liên quan đến kỹ năng làm việc, sự hợp tác, và lãnh đạo thông qua thiền và chánh niệm. BEHF không chỉ mang đến giải pháp cho doanh nghiệp, mà còn đóng góp tích cực vào sự phát triển bền vững của cộng đồng.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/6d260e16ca1a4bd9bd91b0140c3a35ef"
    }
  ],
  "settingsData": [
