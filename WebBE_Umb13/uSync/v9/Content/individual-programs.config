      <Value Culture="vi"><![CDATA[{
  "layout": {
    "Umbraco.BlockGrid": [
      {
        "contentUdi": "umb://element/4b2ad8cef55040b4a862b44f03958102",
        "settingsUdi": "umb://element/66744640afd4446391bf2c1678a52d41",
        "areas": [
          {
            "key": "c4b3726a-9414-45f6-a061-4d5509bc7a72",
            "items": [
              {
                "contentUdi": "umb://element/64496ca20b9d4b84b5bd0b96ec257b86",
                "areas": [],
                "columnSpan": 6,
                "rowSpan": 1
              },
              {
                "contentUdi": "umb://element/59af32789444412a9f85eda184df32c5",
