      }
    ]
  },
  "contentData": [
    {
      "contentTypeKey": "fe26a33e-9f64-4725-954d-dc75d53f5114",
      "udi": "umb://element/6fa175a8ca274660af9d2e2fa540aff1"
    },
    {
      "actionLink": "",
      "contentTypeKey": "6bfd106c-7558-496b-829c-992ecaaf9c73",
      "heading": "Tầm Nhìn",
      "highlightParagraph": "Chúng tôi mong muốn lan tỏa niềm vui và nâng cao nhận thức trên toàn cầu, thúc đẩy sự thống nhất vượt qua ranh giới và kết nối nhân loại.",
      "image": [
        {
          "key": "5d97efe2-374b-451f-bee5-fbf44a7ee048",
          "mediaKey": "efd4be07-e5ec-41f3-8052-69ffd2ab372a"
        }
      ],
      "mediaOnRight": "0",
      "notUseJbtOuter": "0",
      "paragraph": {
        "markup": "<p>BEHF hướng tới một thế giới nơi các doanh nghiệp và tổ chức phát triển bền vững, hiệu quả và hài hòa thông qua việc tích hợp thiền và chánh niệm vào văn hóa làm việc.</p>\n<p>Chúng tôi đặt mục tiêu nâng cao năng lực lãnh đạo, cải thiện hiệu suất làm việc và xây dựng văn hóa hợp tác, từ đó tạo ra tác động tích cực cho con người, cộng đồng, và xã hội trên quy mô toàn cầu.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "shadowRichtext": "0",
      "showIcon": "0",
      "subHeading": "",
      "udi": "umb://element/c7ddf6c0baa6471388a2cadf0a556026",
      "youtubeVideo": ""
    },
    {
      "contentTypeKey": "83e6f05b-2396-4781-9956-24e2a4f3e804",
      "displayStyle": [
        "row"
      ],
      "heading": "Sứ Mệnh",
      "iconPosition": [
        "top"
      ],
      "image": [
        {
          "key": "e58c02b5-d833-468a-a6f4-a3fa4bf04636",
          "mediaKey": "58f7420e-b3d3-4b0e-b748-73a475f563ce"
        }
      ],
      "items": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/42beb9590584481a83ca2f753c104f3f"
