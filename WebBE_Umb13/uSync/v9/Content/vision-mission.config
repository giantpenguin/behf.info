            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Tình yêu thương",
            "iconImage": [
              "love-share.svg"
            ],
            "paragraph": "Nuôi dưỡng sự đồng cảm và hiểu biết đối với vạn vật.",
            "udi": "umb://element/9831f304863a4405991e40a9ffb62ef6"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Tiến bộ",
            "iconImage": [
              "affection.svg"
            ],
            "paragraph": "Thúc đẩy sự đổi mới bền vững để tạo ra tác động lâu dài.",
            "udi": "umb://element/88a4557402de4a448a1a9204562c3b85"
          },
