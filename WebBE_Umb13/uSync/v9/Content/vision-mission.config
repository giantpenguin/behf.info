            {
              "contentUdi": "umb://element/19ff470bf7074dd1aae0ffe364b3bf14"
            }
          ]
        },
        "contentData": [
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Inspiring empowerment",
            "iconImage": [
              "holistic-harmony.svg"
            ],
            "paragraph": "so individuals can realize their full potential and lead fulfilling lives characterized by happiness and peace.",
            "udi": "umb://element/7da2ea349f934b80a5c38694e00e51b3"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Encouraging mindfulness",
            "iconImage": [
              "meditation-mind.svg"
            ],
            "paragraph": "to help individuals remain present in every moment while embracing innovation for continuous improvement in our practices.",
            "udi": "umb://element/21172b6f5c014868bba23309b118cacb"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Unifying people",
            "iconImage": [
              "love-share.svg"
            ],
            "paragraph": "across families, organizations, and communities to nurture a sense of unity that supports inclusivity and co-operation.",
            "udi": "umb://element/aac79509a3044aa187536b576f3e3773"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Cultivating harmony",
            "iconImage": [
              "eye-palm.svg"
            ],
            "paragraph": "by fostering balance within ourselves and with the world around us.",
            "udi": "umb://element/d8137c48382b460a9ac2e4b010a18192"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Promoting compassion & understanding",
            "iconImage": [
              "lotus-woman.svg"
            ],
            "paragraph": "towards all beings while upholding integrity in all our actions.",
            "udi": "umb://element/74f489aa51e14a7583a83b3b3fb1f20f"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Expressing gratitude",
            "iconImage": [
              "love-around.svg"
            ],
            "paragraph": "for the value of life and its experiences, committing to sustainability by protecting and nurturing the environment as we address mental health issues and enhance the effectiveness of organizations and contributing positively to economic development.",
            "udi": "umb://element/19ff470bf7074dd1aae0ffe364b3bf14"
          }
        ],
        "settingsData": []
      },
      "paragraph": {
        "markup": "<p>Our mission is to empower individuals and organizations to unlock their potential through valuable knowledge and experiences in Meditation and Mindfulness. We are dedicated to:</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
