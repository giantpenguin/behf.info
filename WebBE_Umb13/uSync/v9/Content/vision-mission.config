      "udi": "umb://element/7224c8bc8256447fbb84b334210742b7"
    },
    {
      "actionLink": "",
      "contentTypeKey": "6bfd106c-7558-496b-829c-992ecaaf9c73",
      "heading": "Our Vision",
      "highlightParagraph": "We envision a future where people are deeply connected to their life-purpose, prioritizing well-being and fostering unity that transcends boundaries to connect all of humanity.",
      "image": [
        {
          "key": "5d97efe2-374b-451f-bee5-fbf44a7ee048",
          "mediaKey": "efd4be07-e5ec-41f3-8052-69ffd2ab372a"
        }
      ],
      "mediaOnRight": "0",
      "notUseJbtOuter": "0",
      "paragraph": {
        "markup": "<p>The Breath Energy Health Foundation envisions a world where individuals, families, and communities thrive in healthy and happy life, empowered by the deep wisdom of Meditation and Mindfulness.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "shadowRichtext": "0",
      "showIcon": "0",
      "subHeading": "",
      "udi": "umb://element/c1a7b93d3b2c4b6eaaefa58dcedced78",
      "youtubeVideo": ""
    },
    {
      "contentTypeKey": "83e6f05b-2396-4781-9956-24e2a4f3e804",
      "displayStyle": [
        "row"
      ],
      "heading": "Our Mission",
      "iconPosition": [
        "top"
      ],
      "image": [
        {
          "key": "e58c02b5-d833-468a-a6f4-a3fa4bf04636",
          "mediaKey": "58f7420e-b3d3-4b0e-b748-73a475f563ce"
        }
      ],
      "items": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/7da2ea349f934b80a5c38694e00e51b3"
