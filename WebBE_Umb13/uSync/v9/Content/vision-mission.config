            {
              "contentUdi": "umb://element/217d704d73724e099590a99f859c4ef8"
            },
            {
              "contentUdi": "umb://element/9cc679b51d8c4e2e87aaf95e8edffca4"
            },
            {
              "contentUdi": "umb://element/1a598835c1464dbab8144f70ca8a5556"
            },
            {
              "contentUdi": "umb://element/94e4aca6d32147738dc68fff75ef1f70"
            }
          ]
        },
        "contentData": [
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Nuôi dưỡng sự hài hòa",
            "iconImage": [
              "holistic-harmony.svg"
            ],
            "paragraph": "bằng cách tạo ra sự cân bằng bên trong và thế giới bên ngoài.",
            "udi": "umb://element/42beb9590584481a83ca2f753c104f3f"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Nuôi dưỡng tình yêu thương và hiểu biết",
            "iconImage": [
              "meditation-mind.svg"
            ],
            "paragraph": "đối với vạn vật, đồng thời giữ gìn sự chính trực trong mọi hành động.",
            "udi": "umb://element/4ddc3966c5384926b545cc9af44b9053"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Kết nối",
            "iconImage": [
              "love-share.svg"
            ],
            "paragraph": "mọi gia đình, tổ chức, cộng đồng để hướng tới hòa hợp và hợp tác.",
            "udi": "umb://element/be13f7f8b927414eb305736bd8a600ff"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Truyền cảm hứng trao quyền",
            "iconImage": [
              "eye-palm.svg"
            ],
            "paragraph": "cho các cá nhân để mỗi người có thể nhận thức đầy đủ tiềm năng của mình và sống một cuộc sống trọn vẹn, tràn ngập hạnh phúc và bình an.",
            "udi": "umb://element/acf1920dc0f64591a9a592a762856b84"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Khuyến khích thực hành chánh niệm",
            "iconImage": [
              "lotus-woman.svg"
            ],
            "paragraph": "để giúp mỗi người luôn hiện diện trong từng khoảnh khắc đồng thời tiếp thu những đổi mới để cải tiến liên tục.",
            "udi": "umb://element/217d704d73724e099590a99f859c4ef8"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Nuôi dưỡng lòng biết ơn",
            "iconImage": [
              "love-around.svg"
            ],
            "paragraph": "về giá trị của cuộc sống và những trải nghiệm của cuộc sống.",
            "udi": "umb://element/9cc679b51d8c4e2e87aaf95e8edffca4"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Cam kết phát triển bền vững",
            "iconImage": [
              "lotus-water.svg"
            ],
            "paragraph": "bằng cách bảo vệ và nuôi dưỡng môi trường.",
            "udi": "umb://element/1a598835c1464dbab8144f70ca8a5556"
          },
          {
            "boxShadow": "1",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Giải quyết các vấn đề về sức khỏe tâm thần",
            "iconImage": [
              "reforestation.svg"
            ],
            "paragraph": "nâng cao hiệu quả của các doanh nghiệp/tổ chức, đồng thời đóng góp tích cực vào sự phát triển kinh tế.",
            "udi": "umb://element/94e4aca6d32147738dc68fff75ef1f70"
          }
        ],
        "settingsData": []
      },
      "paragraph": {
        "markup": "<p>Đồng hành giúp các cá nhân và tổ chức khám phá tiềm năng của mình thông qua kiến thức và trải nghiệm về thiền và chánh niệm.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "subHeading": "",
      "udi": "umb://element/fe2244db4c5549e48b9ff3ed4b8459a0"
    },
