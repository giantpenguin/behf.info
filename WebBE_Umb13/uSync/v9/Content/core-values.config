            {
              "contentUdi": "umb://element/e844a24fc0c64feb81c1895e759a35c9"
            },
            {
              "contentUdi": "umb://element/5ee2dfeb948445168080e2989828117d"
            },
            {
              "contentUdi": "umb://element/6831b4165c064b279a6bd78473871427"
            }
          ]
        },
        "contentData": [
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Harmony",
            "iconImage": [
              "holistic-harmony.svg"
            ],
            "paragraph": "Cultivating balance within oneself and with the surrounding world.",
            "udi": "umb://element/edfae2d2a529476ea64aa9669bbf5153"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Unity",
            "iconImage": [
              "love-around.svg"
            ],
            "paragraph": "Promoting inclusivity and cooperation across diverse communities.",
            "udi": "umb://element/d57271346af647459ec98c9755603988"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Mindfulness",
            "iconImage": [
              "meditation-mind.svg"
            ],
            "paragraph": "Encouraging awareness and presence in every moment.",
            "udi": "umb://element/a52389a522b04c40b12c9b299a488f68"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Integrity",
            "iconImage": [
              "lotus-water.svg"
            ],
            "paragraph": "Upholding honesty and transparency in all actions.",
            "udi": "umb://element/8c915a189b914fba9f96accbae7789e2"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Compassion",
            "iconImage": [
              "love-share.svg"
            ],
            "paragraph": "Fostering empathy and understanding towards all beings.",
            "udi": "umb://element/d12d97c2ef9a40278ee39a8da81446a3"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Advancement (Innovation)",
            "iconImage": [
              "affection.svg"
            ],
            "paragraph": "Innovate sustainably for lasting impact.",
            "udi": "umb://element/2570c6cc6e6a4d8dafe7f83b973a7d90"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Respect (Gratitude)",
            "iconImage": [
              "flower.svg"
            ],
            "paragraph": "Appreciating the value of life and its experiences.",
            "udi": "umb://element/e844a24fc0c64feb81c1895e759a35c9"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Empowerment",
            "iconImage": [
              "eye-palm.svg"
            ],
            "paragraph": "Inspiring individuals to realize their full potential.",
            "udi": "umb://element/5ee2dfeb948445168080e2989828117d"
          },
          {
            "boxShadow": "0",
            "contentTypeKey": "cce63ab6-4e56-4a76-b794-33d72007063d",
            "heading": "Sustainability",
            "iconImage": [
              "reforestation.svg"
            ],
            "paragraph": "Committing to practices that protect and nurture the environment.",
            "udi": "umb://element/6831b4165c064b279a6bd78473871427"
          }
        ],
        "settingsData": []
      },
      "paragraph": {
        "markup": "<p>BEHF’s commitment to creating a positive impact on individuals and communities.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "subHeading": "HUMICARE = HUMAN + CARES",
      "udi": "umb://element/2c049a2981994d848428640d8d1dbbe1"
    },
    {
      "actionLink": "",
      "contentTypeKey": "6bfd106c-7558-496b-829c-992ecaaf9c73",
      "heading": "TRANSFORMATION TRIANGLE",
      "highlightParagraph": "This framework serves as our guiding philosophy and helps us ensure that every interaction, every program, and every initiative we do is balanced and impactful.",
      "image": [
        {
          "key": "ff9ca72c-f924-4f68-b078-167c3ce9f5fe",
          "mediaKey": "21ccdeb5-5241-4187-9b8e-17bc7c18ac45"
        }
      ],
      "mediaOnRight": "0",
      "notUseJbtOuter": "1",
      "paragraph": {
        "markup": "<p>At the heart of our outreach strategy lies the Transformation Triangle - a model that embodies the key principles guiding our initiatives: <strong>Personal Development</strong>, <strong>Ethical Leadership</strong>, and <strong>Sustainability &amp; Growth</strong>.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "shadowRichtext": "0",
      "showIcon": "0",
      "subHeading": "",
      "udi": "umb://element/c8d9fe8848eb49aba807e32696bb2ce0",
      "youtubeVideo": ""
    }
  ],
  "settingsData": [
