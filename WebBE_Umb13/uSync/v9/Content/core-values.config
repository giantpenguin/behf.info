        "circle"
      ],
      "heading": "Core Values",
      "iconPosition": "",
      "image": [
        {
          "key": "80bbd01b-79fd-4c30-a768-b4705ec34801",
          "mediaKey": "58f7420e-b3d3-4b0e-b748-73a475f563ce"
