@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using UmbNav.Core.Extensions
@using YeahWeb.Extensions;
@inject IUmbracoContextAccessor _umbracoContextAccessor
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HomePage>

@{
    Layout = null;
    var socialLinks = Model.Value<IEnumerable<Link>>("socialLinks") ?? Enumerable.Empty<Link>();
    var currentPage = _umbracoContextAccessor.GetCurrentPage();
    var availCultures = Umbraco.GetLocalizedLangInfos(currentPage);
    var pageCulture = currentPage?.GetCultureFromDomains()?.ToLower();
    var curCulItem = availCultures.FirstOrDefault(i => i.Key == pageCulture);
    if (!string.IsNullOrEmpty(pageCulture))
        availCultures.Remove(pageCulture);
}
@if (socialLinks.Count() > 0)
{
    <div class="share-icons center-left a-fadein a-fadein--left a-delay--25 d-none d-lg-block" style="--color: #fff; --bg-color: #5c3960; --icon-bg-color:#543458;">
        <ul>
            @foreach (var item in socialLinks)
            {
                var socialClass = "";
                switch (item.Name.ToLowerInvariant())
                {
                    case "facebook":
                        socialClass = "fa-brands fa-facebook-f";
                        break;
                    case "youtube":
                        socialClass = "fa-brands fa-youtube";
                        break;
                    case "zalo":
                        socialClass = "icon icon-zalo icon-2x";
                        break;
                        @* case "instagram":
                        socialClass = "fa-brands fa-instagram";
                        break;
                    case "twitter":
                        socialClass = "fa-brands fa-twitter";
                        break; *@
                }
                <li><a href="@item.Url" target="@item.Target" title="@item.Name"><i class="@socialClass" aria-hidden="true"></i></a></li>
            }
        </ul>
    </div>
}

<header class="site-header" style="--color:rgba(118,73,121,1); --active-color: rgba(97,45,145,1)">
    <nav class="site-navbar navbar fixed-top navbar-expand-xl theme-hero">
        <div class="container">
            <a class="navbar-brand" href="@Model.Url()" title="@Model.SiteName">
                <img src="@Model.Logo?.GetCropUrl())" alt="@Model.SiteName logo" />
            </a>
            <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#Navbar" aria-controls="Navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-lbl">Menu</span>
                <i class="fa-solid fa-bars"></i>
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="collapse navbar-collapse" id="Navbar">
                <div class="navbar-collapse-wrap">
                    <ul class="navbar-nav">
                    @foreach (var meuItemL1 in Model.MainMenu!)
                    {
                        var custCss = meuItemL1.CustomClasses ?? "";
                        var dropdownCss = meuItemL1.Children.Any() ? "dropdown" : "";

                        <li class="nav-item @dropdownCss @custCss">
                            @if (string.IsNullOrEmpty(dropdownCss))
                            {
                                var navLinkCss = custCss.Contains("nav-button_reverse") ? "btn btn-primary btn-bdrd-mirror" : custCss.Contains("nav-button") ? "btn btn-primary" : "nav-link";
                                <a class="@navLinkCss @Html.If(meuItemL1.IsActive(currentPage, false), "active")" href="@meuItemL1.Url()" target="@meuItemL1.Target">@meuItemL1.Title</a>
                            }
                            else
                            {
                                <a class="nav-link dropdown-toggle" href="@meuItemL1.Url()" target="@meuItemL1.Target" id="navbarDropdown" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    <span>@meuItemL1.Title</span>
                                    <i class="fa-solid fa-angle-down"></i>
                                </a>
                                <div class="navbar-dropdown-menu dropdown-menu size--auto" aria-labelledby="navbarDropdownSample2">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-12 col-md-6 col-lg-3">
                                                <ul class="menu-level-2">
                                                @foreach (var meuItemL2 in meuItemL1.Children)
                                                {
                                                    <li>
                                                        <a class="@Html.If(meuItemL2.IsActive(currentPage, false), "active")" href="@meuItemL2.Url()">@meuItemL2.Title</a>
                                                        @if (meuItemL2.Children.Any())
                                                        {
                                                            <ul class="menu-level-3">
                                                            @foreach (var meuItemL3 in meuItemL2.Children)
                                                            {
                                                                <li>
                                                                  <a class="@Html.If(meuItemL3.IsActive(currentPage, false), "active")" href="@meuItemL3.Url()">@meuItemL3.Title</a>
                                                                </li>
                                                            }
                                                          </ul>
                                                        }
                                                    </li>
                                                }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </li>
                    }                        
                    </ul>
                    <div class="site-navbar-group">
                        @* <div class="site-navbar-srch dropdown">
                            <a class="dropdown-toggle" href="javascript:void(0);" id="navbarSearch" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarSearch">
                                <form class="form-wrap">
                                    <input class="form-control" type="search" placeholder="Search" aria-label="Search">
                                    <button class="btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                                </form>
                            </div>
                        </div> *@
                        <div class="site-navbar-lang dropdown">
                            <a id="navbarLanguage" class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <span class="lang-flag"><img src="/assets/images/flag/@curCulItem.Value.Item3" alt=""></span>
                                <span class="lang-title">@curCulItem.Value.Item1</span>
                                <i class="fa-solid fa-angle-down"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarLanguage">
                            @foreach (var kv in availCultures){
                                <li>
                                      <a class="dropdown-item" href="@kv.Value.Item2">
                                        <span class="lang-flag"><img src="/assets/images/flag/@kv.Value.Item3" alt=""></span>
                                        <span class="lang-title">@kv.Value.Item1</span>
                                    </a>
                                </li>
                            }
                            </ul>
                        </div>
                        @if (socialLinks.Count() > 0)
                        {
                            <div class="share-icons d-block d-lg-none">
                                <ul>
                                @foreach (var item in socialLinks)
                                {
                                    var socialClass = "";
                                    switch (item.Name.ToLowerInvariant())
                                    {
                                        case "facebook":
                                            socialClass = "fa-brands fa-facebook-f";
                                            break;
                                        case "youtube":
                                            socialClass = "fa-brands fa-youtube";
                                            break;
                                        case "zalo":
                                            socialClass = "icon icon-zalo icon-2x";
                                            break;
                                        @* case "instagram":
                                            socialClass = "fa-brands fa-instagram";
                                            break;
                                        case "twitter":
                                            socialClass = "fa-brands fa-twitter";
                                            break; *@
                                    }
                                    <li><a href="@item.Url" target="@item.Target" title="@item.Name"><i class="@socialClass" aria-hidden="true"></i></a></li>
                                }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>