@using Umbraco.Cms.Core.PropertyEditors.ValueConverters
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@using YeahWeb.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>

@{
    // var imgUrl = Model.Value<IPublishedContent>("image")?.GetCropUrl(/* width: 150, height: 150 */);
    var styleColor = Model.Content.GetBgrRGBAForStyle();
    var padding = string.IsNullOrEmpty(styleColor) ? "" : "py-4 px-4";
}

<div class="card-quote @padding" style="@styleColor">
    <div class="card-quote__wrp">
        <div class="card-quote__icn">
            <i class="fa-solid fa-quote-left"></i>
        </div>
        <div class="card-quote__cnt text-quote a-fadein a-fadein--left">
            @Model.Content.Value("paragraph")
        </div>
    </div>
</div>