@using Umbraco.Cms.Core.PropertyEditors.ValueConverters
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using YeahWeb.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>

@{
    var heading = Model.Content.Value<string>("heading");
    var highlightText = Model.Content.Value<string>("highlightParagraph");

    var iconImgBigger = Model.Content.Value<bool>("iconImageBigger");
    var imgUrl = Model.Content.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("iconImage")?.GetCropUrl(width: iconImgBigger ? 320 : 150);
    var iconImgSize = iconImgBigger ? "icon-img-aside_bigger" : "icon-img-aside";
    var iconOnRight = Model.Content.Value<bool>("iconImageOnRight");
    var reverseClass = iconOnRight ? "flex-row-reverse" : "";
    var midleMargin = iconOnRight ? "ms-3" : "me-3";

    var imgCaption = Model.Content.Value<string>("iconImageCaption");

    var styleColor = Model.Content.GetBgrRGBAForStyle();
    var addPadding = string.IsNullOrEmpty(styleColor) ? "" : "py-4 px-4";
}

<div class="section-block__cnt @addPadding" style="@styleColor">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="d-flex align-items-start @reverseClass stack-on-xs">
              @if (!string.IsNullOrEmpty(imgUrl))
              {                
                <figure class="@midleMargin img-container">
                  <img src="@imgUrl" class="@iconImgSize" alt="icon image @heading">
                  @if(!string.IsNullOrEmpty(imgCaption)) {
                    <figcaption>@imgCaption</figcaption>
                  }
                </figure>                
              }
              <div class="text-content-wrapper">
                @if (!string.IsNullOrWhiteSpace(heading)) {
                    <h2 class="section-block__tle a-fadein a-fadein--right">@heading</h2>
                }
                @if (!string.IsNullOrWhiteSpace(highlightText)) { 
                  <div class="text-highlight border-left a-fadein a-fadein--left" style="--color: #764979; --border-color: #764979; --border-width: 3px">
                      @highlightText
                  </div>
                }
                @if (Model.Content.HasValue("paragraph")){
                  <div class="text-lg  card-plan__fet">
                    @Model.Content.Value("paragraph")
                  </div>
                }
              </div>
            </div>
        </div>
    </div>
</div>